(version 1)
(allow default)
(deny file-write*)
(allow file-write*
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Public")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Private")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Public/development-strategy-baseline.json")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Public/development-strategy-baseline.json.tmp")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Public/futility-stop.json")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Public/futility-stop.json.tmp")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Public/models-frozen.json")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Public/models-frozen.json.tmp")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Private/training-attempt.json")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Private/Ridge.joblib")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Private/Boosting.joblib")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Private/Ridge-state.json")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Private/Ridge-state.json.tmp")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Private/Boosting-state.json")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Private/Boosting-state.json.tmp")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Private/Ridge-cross-predictions.json")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Private/Ridge-cross-predictions.json.tmp")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Private/Boosting-cross-predictions.json")
  (literal "${WORKSPACE}/outputs/ES-FiveYear-ML-20261121/Private/Boosting-cross-predictions.json.tmp")
)
(deny network*)
(deny file-read* (regex "^${WORKSPACE_REGEX}/outputs/ES\\-FiveYear\\-SecondData\\-20261121/Private/sealed-"))
